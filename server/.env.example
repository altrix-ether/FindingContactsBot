PORT=3001
GITHUB_TOKEN=

# Repo-wide contact scan (requires token for practical rate limits)
SCAN_MAX_REPOS=40
SCAN_COMMITS_PER_REPO=30
SCAN_ISSUES_PER_REPO=8
SCAN_RELEASES_PER_REPO=5
SCAN_CONCURRENCY=4

# Contributor scan (when URL includes owner/repo)
SCAN_MAX_CONTRIBUTORS=50
SCAN_CONTRIBUTOR_CONCURRENCY=2
SCAN_CONTRIBUTOR_MAX_REPOS=5
SCAN_CONTRIBUTOR_COMMIT_PAGES=3

# Max repository URLs per batch request
SCAN_MAX_BATCH_REPOS=10